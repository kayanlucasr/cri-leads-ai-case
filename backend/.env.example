# Porta opcional; o padrão é 3001.
PORT=3001

# Obrigatórias. Preencha somente em backend/.env, ignorado pelo Git.
# SUPABASE_URL: Project URL no botão Connect do projeto Supabase.
SUPABASE_URL=
# SUPABASE_SECRET_KEY: Settings > API Keys > Secret keys (sb_secret_...).
# Chave privilegiada, exclusiva do servidor. Não use publishable/anon aqui.
SUPABASE_SECRET_KEY=

# Necessárias somente para gerar sugestões; listagem funciona sem elas.
# Crie a chave em https://platform.openai.com/api-keys e preencha em backend/.env.
OPENAI_API_KEY=
# Sugestão inicial: gpt-4.1-mini. Escolha um modelo compatível com Responses API.
OPENAI_MODEL=

# Nunca coloque secrets em variáveis VITE_ ou em arquivos do frontend.
